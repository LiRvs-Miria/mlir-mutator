@LIT_SITE_CFG_IN_HEADER@

config.llvm_src_root = path(r"@LLVM_SOURCE_DIR@")
config.llvm_tools_dir = lit_config.substitute(path(r"@LLVM_TOOLS_DIR@"))
config.llvm_shlib_ext = "@SHLIBEXT@"
config.enable_assertions = @ENABLE_ASSERTIONS@
config.mlir_mutator_src_root = path(r"@MLIRMUTATOR_SOURCE_DIR@")
config.mlir_mutator_obj_root = path(r"@MLIRMUTATOR_BINARY_DIR@")
config.mlir_mutator_tools_dir = path(r"@MLIRMUTATOR_TOOLS_DIR@")
config.mlir_mutator_lib_dir = path(r"@MLIRMUTATOR_LIB_DIR@")

import lit.llvm
lit.llvm.initialize(lit_config, config)

# Let the main config do the real work.
lit_config.load_config(
    config, os.path.join(path(r"@MLIRMUTATOR_SOURCE_DIR@"), "test/lit.cfg.py"))
